<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="http://schemas.microsoft.com/.NetConfiguration/v2.0">
  <configSections>
    <section name="botDetect" requirePermission="false" type="BotDetect.Configuration.BotDetectConfigurationSection, BotDetect" />
    <sectionGroup name="elmah">
      <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
      <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
      <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
      <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
	  <remove name="LocalSqlServer" />
	  <!--<add name="LocalSqlServer" connectionString="server=COMEFROMDBCONFIG;database=aspnetdb;user=compasssystemuser;pwd=(Cc243!!!;" />-->
	  <add name="LocalSqlServer" connectionString="server=cg-pro-web1-tst;database=aspnetdb;user=compasssystemuser;pwd=ccc243;" />
  </connectionStrings>
  <appSettings>
	<add key="SameSiteToCookie" value="1" />
	<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="AcademicYearID" value="21/22" />
    <add key="Connection.DefaultLogicalDatabase" value="PSWebEnrolment" />
    <!--Timeout values in seconds-->
    <add key="Connection.DefaultTimeout" value="60" />
    <add key="Connection.DefaultLongTimeout" value="1200" />
    <!-- payment providers -->
    <add key="UseWorldPay" value="1" />
    <add key="UseRealEx" value="0" />
    <add key="UsePayPal" value="0" />
    <!-- Sub account name for RealEx-->
    <add key="RealEx.Account" value="0" />
    <!-- Use this for WorldPay InstID, RealEx Identifier or PayPal email/account number-->
    <add key="WorldPay.instId" value="1057852" />
	<add key="WorldPay.testmode" value="100" />
	<add key="WorldPay.SubmitURL" value="https://secure-test.worldpay.com/wcc/purchase" />
    <!--RealEx sandbox - https://hpp.sandbox.realexpayments.com/pay -->
    <!--PaypPal sandbox - https://www.sandbox.paypal.com/uk/cgi-bin/webscr? -->
    <!--WorldPay or RealEx Shared Secret-->
    <add key="Shared" value="" />
    <!-- end payment providers -->
    <!-- address providers -->
    <!-- QAS Pro Web -->
    <add key="com.qas.proweb.serverURL" value="http://cg-pro-web1-tst:2021" />
    <add key="com.qas.proweb.layout" value="Database Layout" />
    <!-- QAS Pro On Demand -->
    <add key="UseQASProOnDemand" value="0" />
    <add key="Experian.Qas.Capture.OnDemandUrl" value="https://ws.ondemand.qas.com/ProOnDemand/V3/ProOnDemandService.asmx" />
    <add key="Experian.Qas.Capture.OnDemandUsername" value="ONDEMAND_USERNAME" />
    <add key="Experian.Qas.Capture.OnDemandPassword" value="ONDEMAND_PASSWORD" />
    <!-- Capscan OnDemand -->
    <add key="UseCapscan" value="False" />
    <add key="CapscanClientID" value="" />
    <add key="CapscanAccessCode" value="" />
    <!--AFD / AFD Evolution -->
    <add key="UseAFD" value="0" />
    <add key="UseAFDEvolution" value="1" />
    <add key="AFDPEServer" value="http://pce.afd.co.uk" />
    <add key="AFDPESerialNumber" value="831230" />
    <add key="AFDPEPassword" value="AFO70Hy1" />
    <add key="AFDPEUserID" value="CITYO01" />
    <!-- end address providers -->
    <add key="CollegeOrganisationID" value="1" />
    <add key="ShouldVerifyEmail" value="1" />
  </appSettings>
  <system.web>
    <customErrors mode="Off" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" culture="en-GB" uiCulture="en-GB" />
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Web.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
      </assemblies>
    </compilation>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <namespaces>
        <clear />
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.Configuration" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
        <add namespace="CustomControl" />
        <add namespace="CompassCC.ProSolution.Business" />
      </namespaces>
      <controls>
        <add tagPrefix="cc1" assembly="PSWebEnrolmentKit" namespace="CompassCC.ProSolution.PSWebEnrolmentKit" />
        <add tagPrefix="cc2" namespace="CustomControl" />
        <add assembly="BotDetect" namespace="BotDetect.Web.UI" tagPrefix="BotDetect" />
      </controls>
    </pages>
    <authentication mode="Forms" />
    <anonymousIdentification enabled="true" cookieTimeout="8000" />
	  <sessionState timeout="1800" />
    <profile enabled="true">
      <providers>
        <remove name="AspNetSqlProfileProvider" />
        <add name="AspNetSqlProfileProvider" connectionStringName="LocalSqlServer" applicationName="/" type="System.Web.Profile.SqlProfileProvider" />
      </providers>
      <properties>
        <add name="ShoppingCart" type="CompassCC.ProSolution.PSWebEnrolmentKit.ShoppingCart" allowAnonymous="true" serializeAs="Binary" />
        <add name="EnrolmentRequest" type="CompassCC.ProSolution.PSWebEnrolmentKit.EnrolmentRequestDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="ApplicationRequest" type="CompassCC.ProSolution.Business.ApplicationRequestDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="StudentDetail" type="CompassCC.ProSolution.Business.StudentDetailDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="EnquiryRequest" type="CompassCC.ProSolution.Business.EnquiryRequestDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="EnrolmentRequestQualsOnEntry" type="CompassCC.ProSolution.Business.EnrolmentRequestQualsOnEntryDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="ApplicationRequestQualsOnEntry" type="CompassCC.ProSolution.Business.ApplicationRequestQualsOnEntryDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="EnrolmentRequestHE" type="CompassCC.ProSolution.Business.EnrolmentRequestHEDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="ApplicationRequestHE" type="CompassCC.ProSolution.Business.ApplicationRequestHEDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="EnrolmentRequestEmploymentHistory" type="CompassCC.ProSolution.Business.EnrolmentRequestEmploymentHistoryDataTable" allowAnonymous="true" serializeAs="Xml" />
        <add name="ApplicationRequestEmploymentHistory" type="CompassCC.ProSolution.Business.ApplicationRequestEmploymentHistoryDataTable" allowAnonymous="true" serializeAs="Xml" />
      </properties>
    </profile>
    <httpRuntime requestValidationMode="2.0" maxRequestLength="1048576" enableVersionHeader="false" />
    <httpHandlers>
      <add verb="POST,GET,HEAD" path="elmah.axd" type="Elmah.ErrorLogPageFactory, Elmah" />
      <add verb="GET" path="BotDetectCaptcha.ashx" type="BotDetect.Web.CaptchaHandler, BotDetect" />
    </httpHandlers>
    <httpModules>
      <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
    </httpModules>
  </system.web>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="CapscanOnDemandSoap" bypassProxyOnLocal="true" />
        <binding name="CapscanOnDemandSoap1" />
      </basicHttpBinding>
      <customBinding>
        <binding name="CapscanOnDemandSoap12">
          <textMessageEncoding messageVersion="Soap12" />
          <httpTransport proxyAuthenticationScheme="Ntlm" />
        </binding>
        <binding name="CapscanOnDemandSoap121">
          <textMessageEncoding messageVersion="Soap12" />
          <httpTransport />
        </binding>
      </customBinding>
    </bindings>
    <client>
      <endpoint address="http://www.capscanondemand.com/capscanondemand/capscanondemand.asmx" binding="basicHttpBinding" bindingConfiguration="CapscanOnDemandSoap" contract="CapscanService.CapscanOnDemandSoap" name="CapscanOnDemandSoap" />
      <endpoint address="http://www.capscanondemand.com/capscanondemand/capscanondemand.asmx" binding="customBinding" bindingConfiguration="CapscanOnDemandSoap12" contract="CapscanService.CapscanOnDemandSoap" name="CapscanOnDemandSoap12" />
      <endpoint address="http://www.capscanondemand.com/capscanondemand/capscanondemand.asmx" binding="basicHttpBinding" bindingConfiguration="CapscanOnDemandSoap1" contract="CapscanService.CapscanOnDemandSoap" name="CapscanOnDemandSoap1" />
      <endpoint address="http://www.capscanondemand.com/capscanondemand/capscanondemand.asmx" binding="customBinding" bindingConfiguration="CapscanOnDemandSoap121" contract="CapscanService.CapscanOnDemandSoap" name="CapscanOnDemandSoap121" />
    </client>
  </system.serviceModel>
  <!--<system.net>
    <defaultProxy enabled="true" useDefaultCredentials="false">
      <module type = "Proxy.ProxyClass, Proxy" />
    </defaultProxy>
  </system.net>-->
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="Admissions@cityofbristol.ac.uk">
        <network defaultCredentials="true" host="smtp.cityofbristol.ac.uk" port="25" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="Elmah.ErrorLog" type="Elmah.ErrorLogModule, Elmah" preCondition="managedHandler" />
    </modules>
    <handlers>
      <add name="Elmah" path="elmah.axd" verb="POST,GET,HEAD" type="Elmah.ErrorLogPageFactory, Elmah" preCondition="integratedMode" />
      <remove name="BotDetectCaptchaHandler" />
      <add name="BotDetectCaptchaHandler" preCondition="integratedMode" verb="GET" path="BotDetectCaptcha.ashx" type="BotDetect.Web.CaptchaHandler, BotDetect" />
    </handlers>
        <rewrite>
            <rewriteMaps>
                <rewriteMap name="BAD_EAPP" defaultValue="">
                    <add key="/PSWebEnrolment/webenrolment.aspx?page=~/webcontrols/courseenrol.ascx&amp;OfferingID=188789" value="/PSWebEnrolment/webenrolment.aspx?page=~/webcontrols/courseapply.ascx&amp;OfferingID=188789" />
                </rewriteMap>
            </rewriteMaps>
            <rules>
                <rule name="ESOL App Enrol to Application" stopProcessing="true">
<match url=".*" />
      <conditions logicalGrouping="MatchAll">
        <add input="{BAD_EAPP:{REQUEST_URI}}" pattern="(.+)" />
      </conditions>
      <action type="Redirect" url="{C:1}" appendQueryString="false" redirectType="Permanent"  />
                </rule>
            </rules>
        </rewrite>
      
  </system.webServer>
  <elmah>
    <security allowRemoteAccess="0" />
    <errorLog type="Elmah.SqlErrorLog, Elmah" connectionStringName="" />
  </elmah>
</configuration>